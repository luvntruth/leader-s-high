# ──────────────────────────────────────────────────────────────────
# Leader's High — 환경변수 설정 가이드
# 이 파일을 복사하여 .env.local 을 만드세요:
#   cp .env.example .env.local
# ──────────────────────────────────────────────────────────────────

# ── 개발 환경 (로컬 개발 전용) ─────────────────────────────────────
# Gemini API 키 (Google AI Studio에서 발급)
# ⚠️  절대 프로덕션 배포 환경변수에 넣지 마세요!
# ⚠️  절대 git에 커밋하지 마세요! (.gitignore에 이미 포함됨)
VITE_API_KEY=your_gemini_api_key_here

# ── 프로덕션 환경 ───────────────────────────────────────────────────
# Cloudflare Worker 배포 후 얻는 URL
# 프로덕션에서는 VITE_API_KEY 대신 이것만 설정하세요 (API 키가 번들에 포함되지 않음)
# VITE_GEMINI_PROXY_URL=https://leaders-high-proxy.YOUR_SUBDOMAIN.workers.dev
