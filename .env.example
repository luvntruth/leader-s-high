# ──────────────────────────────────────────────────────────────────
# Leader's High — 환경변수 설정 가이드
# 이 파일을 복사하여 .env.local 을 만드세요:
#   cp .env.example .env.local
# ──────────────────────────────────────────────────────────────────

# ── 개발 환경 (로컬 개발 전용) ─────────────────────────────────────
# Gemini API 키 (Google AI Studio에서 발급)
# ⚠️  절대 프로덕션 배포 환경변수에 넣지 마세요!
# ⚠️  절대 git에 커밋하지 마세요! (.gitignore에 이미 포함됨)
VITE_API_KEY=your_gemini_api_key_here

# ── 프로덕션 환경 ───────────────────────────────────────────────────
# Cloudflare Worker 배포 후 얻는 URL
# 프로덕션에서는 VITE_API_KEY 대신 이것만 설정하세요 (API 키가 번들에 포함되지 않음)
# VITE_GEMINI_PROXY_URL=https://leaders-high-proxy.YOUR_SUBDOMAIN.workers.dev

# ── Supabase ──────────────────────────────────────────────────────
# Supabase 프로젝트 설정 (https://supabase.com 에서 생성)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Stripe (결제) ─────────────────────────────────────────────────
# Stripe Publishable Key (클라이언트용)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx

# ── Worker 전용 시크릿 (wrangler secret put 으로 설정) ─────────────
# SUPABASE_JWT_SECRET=xxxxx
# STRIPE_SECRET_KEY=sk_live_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ── Sentry (에러 추적) ────────────────────────────────────────────
# Sentry DSN (https://sentry.io 에서 프로젝트 생성 후 발급)
# VITE_SENTRY_DSN=https://xxxxx@o123456.ingest.sentry.io/123456
